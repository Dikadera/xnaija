NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}
# Firebase Admin (server): paste the full service-account JSON on ONE line
FIREBASE_SERVICE_ACCOUNT=
FIRESTORE_DB_ID=xnaija
# Redis (Upstash rediss:// URL works). Optional: falls back to in-memory cache
REDIS_URL=
TAUK_TO_ID=propertyId/widgetId
ADMIN_WHATSAPP=15551234567
ADMIN_EMAIL=admin@example.com
# NowPayments (USDT). Cryptomus can be swapped in app/api/create-payment
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Video source listing base (used by lib/source.ts)
VIDEO_SOURCE_BASE=https://www.xvideos.com
